# Copy to .env and fill in. NEVER commit .env. No values in this file.

# --- Masumi (Cardano Preprod) ---
NETWORK=Preprod
PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
PAYMENT_SERVICE_URL_DOCKER=http://host.docker.internal:3001/api/v1
PAYMENT_API_KEY=
SELLER_PAYMENT_API_KEY=
BUYER_PAYMENT_API_KEY=
REGISTRY_SERVICE_URL=https://registry.masumi.network/api/v1
REGISTRY_API_KEY=

# Payment Service node itself (server only, see infra/README.md)
BLOCKFROST_API_KEY_PREPROD=
ADMIN_KEY=
DATABASE_URL=
PURCHASE_WALLET_PREPROD_MNEMONIC=
SELLING_WALLET_PREPROD_MNEMONIC=
COLLECTION_WALLET_PREPROD_ADDRESS=
AUTO_WITHDRAW_PAYMENTS=true
AUTO_WITHDRAW_REFUNDS=true
BLOCK_CONFIRMATIONS_THRESHOLD=

# --- Seller agents (ProÚčetní / CheapBooks) ---
FIRM_PROFILE=honest            # honest | sloppy
PORT=8001                      # honest 8001, sloppy 8002
FIRM_PRICE_LOVELACE=5000000    # honest: 5000000 (5 ADA), sloppy: 2000000 (2 ADA)
PAYMENT_MODE=off               # off = SIMULATED, masumi = real escrow
AGENT_IDENTIFIER=
AGENT_IDENTIFIER_HONEST=
AGENT_IDENTIFIER_SLOPPY=
SUPPORTED_PAYMENT_SOURCE_INDEX=0
SELLER_VKEY=
APIFY_TOKEN=

# --- Buyer agent & Dashboard ---
BUYER_PORT=8000
POLICY_MONTHLY_LIMIT_LOVELACE=100000000
POLICY_MAX_PER_TASK_LOVELACE=10000000
POLICY_HUMAN_APPROVAL_THRESHOLD_LOVELACE=4000000
POLICY_DB_PATH=buyer/state/policy.sqlite
MIN_REPUTATION=0.4
SELLER_URLS=http://localhost:8001,http://localhost:8002
DASHBOARD_ADMIN_TOKEN=

# --- LLM Reasoning (OpenRouter / DeepSeek) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Sokosumi (external agent listing) ---
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com/v1
SOKOSUMI_API_KEY=

# --- Optional ---
ELEVENLABS_API_KEY=
JEV_API_KEY=
OPENAI_API_KEY=

